<Window x:Class="AELanguageSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AE 中英文切换器"
        Width="420" Height="260"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F7FA"
        Loaded="Window_Loaded"
        Activated="Window_Activated">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="AE 中英文切换器" FontSize="19" FontWeight="SemiBold"
                       Foreground="#1D1D23" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LanguageLabel}" HorizontalAlignment="Right"
                       FontSize="13" Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="当前 After Effects 语言" />
        </Grid>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="{Binding PrimaryButtonText}"
                    Command="{Binding SwitchCommand}"
                    IsEnabled="{Binding CanSwitch}"
                    MinWidth="190" Height="44"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0"
                    AutomationProperties.Name="切换 After Effects 语言" />
            <TextBlock Text="{Binding StatusMessage}" Margin="0,14,0,0"
                       MaxWidth="340" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="12" Foreground="#686873" />
        </StackPanel>

        <Button Grid.Row="2" Content="重新扫描" Command="{Binding RefreshCommand}"
                HorizontalAlignment="Center" Padding="12,5" FontSize="12"
                Background="Transparent" BorderThickness="0" Foreground="#565661"
                AutomationProperties.Name="重新扫描 After Effects" />
    </Grid>
</Window>
